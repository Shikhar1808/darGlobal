# Get a key at https://openrouter.ai/keys  (copy this file to .env; never commit .env)
OPENROUTER_API_KEY=
# Optional extra keys, tried in order when the one before fails (e.g. its daily limit is used up)
# OPENROUTER_API_KEY_1=
# OPENROUTER_API_KEY_2=
# Optional: any ":free" model id from https://openrouter.ai/models?max_price=0
MODEL=baidu/ernie-5.5-flash-preview:free
FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# optional: Redis with Search + JSON (e.g. Redis Cloud free tier). Unset = in-memory cache and chat memory.
REDIS_URL=
